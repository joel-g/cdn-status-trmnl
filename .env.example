# Copy to .env.local (ignored by git). Existing environment variables take precedence.
# Alternatively, read the two TRMNL variables from an existing dotenv-style secrets file:
# TRMNL_SECRETS_FILE=~/.secrets
# Account API key with Read and Content access to this plugin.
TRMNL_API_KEY=
# Numeric plugin settings ID or plugin UUID, accepted by the Account API.
TRMNL_PLUGIN_SETTING_ID=
TRMNL_WORKER_URL=https://your-worker.your-subdomain.workers.dev
# Account that owns the existing worker and KV namespace.
CLOUDFLARE_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
