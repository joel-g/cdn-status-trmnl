{%- comment -%}
  CDN Status - Quadrant (400x240). Paste into TRMNL: Private Plugin > Edit Markup > Quadrant.
  See full.liquid for the merge variable reference.
{%- endcomment -%}
{%- assign now = "now" | date: "%s" | plus: 0 -%}
<style>
  .cdn { display: flex; flex-direction: column; gap: 6px; width: 100%; height: 100%; }
  .cdn-row { flex: 1; display: flex; flex-direction: column; justify-content: center; gap: 1px; min-height: 0;
             border: 2px solid #000; border-radius: 6px; padding: 2px 8px; overflow: hidden; }
  .cdn-row--major { background: #000; }
  .cdn-row--major * { color: #fff !important; }
  .cdn-row--minor, .cdn-row--error { border-width: 4px; padding: 0 6px; }
  .cdn-row--maint { border-style: dashed; }
  .cdn-line { display: flex; align-items: baseline; justify-content: space-between; gap: 8px; }
  .cdn-desc { min-width: 0; text-align: right; }
  .cdn-c1 { display: -webkit-box !important; -webkit-box-orient: vertical; -webkit-line-clamp: 1; overflow: hidden; word-break: break-word; }
</style>
<div class="layout layout--col layout--top layout--stretch" style="justify-content: flex-start; align-items: stretch;">
  <div class="cdn">
    {%- for p in providers %}
    <div class="cdn-row cdn-row--{{ p.status }}">
      <div class="cdn-line">
        <span class="title title--small">{{ p.name | escape }}</span>
        <span class="label label--small cdn-desc cdn-c1">{{ p.desc | escape }}</span>
      </div>
      {%- assign item = p.items.first %}
      {%- if item %}
      {%- assign age = now | minus: item.u -%}
      {%- capture when -%}
        {%- if item.u == 0 -%}
        {%- elsif age < 3600 -%}{%- assign mins = age | divided_by: 60 | floor -%}{%- if mins < 1 -%}now{%- else -%}{{ mins }}m{%- endif -%}
        {%- elsif age < 86400 -%}{{ age | divided_by: 3600 | floor }}h
        {%- else -%}{{ age | divided_by: 86400 | floor }}d{%- endif -%}
      {%- endcapture %}
      {%- assign hidden = p.items.size | minus: 1 | plus: p.more %}
      <span class="description cdn-c1">{% if when != blank %}{{ when }} · {% endif %}{{ item.t | escape }}{% if hidden > 0 %} (+{{ hidden }}){% endif %}</span>
      {%- endif %}
    </div>
    {%- endfor %}
  </div>
</div>
<div class="title_bar">
  <span class="title">CDN Status</span>
  <span class="instance">{{ checked_at }}</span>
</div>
