{
  "name": "cdn-status-trmnl",
  "version": "2.0.0",
  "description": "TRMNL plugin showing CDN status from Cloudflare, Fastly, and Akamai",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "deploy": "node scripts/deploy.js --worker",
    "deploy:worker": "wrangler deploy",
    "deploy:templates": "node scripts/deploy.js",
    "build": "wrangler deploy --dry-run --outdir dist",
    "test": "node --test"
  },
  "devDependencies": {
    "wrangler": "^4.156.1"
  },
  "dependencies": {
    "liquidjs": "^10.30.1"
  }
}
